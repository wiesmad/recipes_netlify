<!doctype html>
<html lang="pl">
    <head>
        <!-- Podstawy -->
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- SEO: tytuł i opis -->
        <title>{{ page_title }} | Farfalle – przepisy, wypieki i kuchnia vege</title>
        <meta name="description" content="{{ meta_description | default: 'Farfalle – autorskie przepisy, domowe wypieki i kuchnia vege. Prosto, sezonowo i bez zbędnej teorii.' }}" />

        <!-- SEO: indeksowanie -->
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href="{{ canonical_url }}" />

        <!-- Open Graph -->
        <meta property="og:site_name" content="Farfalle" />
        <meta property="og:title" content="{{ og_title | default: page_title }}" />
        <meta property="og:description" content="{{ og_description | default: meta_description }}" />
        <meta property="og:type" content="{{ og_type | default: 'website' }}" />
        <meta property="og:url" content="{{ canonical_url }}" />
        <meta property="og:image" content="{{ og_image | default: '/public/img/og-default.jpg' }}" />

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="{{ og_title | default: page_title }}" />
        <meta name="twitter:description" content="{{ og_description | default: meta_description }}" />
        <meta name="twitter:image" content="{{ og_image | default: '/public/img/og-default.jpg' }}" />

        <!-- Ikony -->
        <link rel="icon" href="/public/img/favicon.png" type="image/png" />
        <link rel="apple-touch-icon" href="/public/img/apple-touch-icon.png" />

        <!-- Performance: fonty -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Imperial+Script&family=Montserrat:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <!-- CSS -->
        <link rel="stylesheet" href="/public/css/variables.css" />
        <link rel="stylesheet" href="/public/css/style.css" />
        <link rel="stylesheet" href="/public/css/modal.css" />

        <!-- JS -->
        <script src="/public/js/script.js" defer></script>

        <!-- Dane strukturalne: Website (globalne) -->
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": "Farfalle",
          "url": "{{ site_url }}",
          "inLanguage": "pl-PL"
        }
        </script>

        <!-- Dane strukturalne: Recipe (tylko na stronach przepisów) -->
        {{ recipe_schema | safe }}
    </head>
    <body>
        <div class="container">
            <header class="site-header">
                <h1><a href="/">farfalle</a></h1>

                <input type="checkbox" id="nav-checkbox" class="nav-checkbox" />

                <label
                    for="nav-checkbox"
                    class="nav-toggle"
                    aria-label="Toggle navigation"
                >
                    ☰
                </label>

                <nav class="nav">
                    <a href="/">Przepisy</a>
                    <a href="/bakery">Wypieki</a>
                    <a href="/vege">Vege</a>
                    <a href="/about">O mnie</a>
                </nav>
            </header>

            <main>{{ content | safe }}</main>
        </div>

    <footer>
        <p>&copy; 2026 Farfalle. Wszelkie prawa zastrzeżone. Właściciel: Wiesław Mazurak. Hosting: Netlify.</p>
    </footer>
    </body>
</html>
