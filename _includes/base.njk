<!doctype html>
<html lang="pl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="{{ seo_description }}">
        <meta name="robots" content="index, follow" />
        <meta property="og:title" content="{{ title }}">
        <meta property="og:description" content="{{ seo_description }}">
        <meta property="og:image" content="{{ metadata.url }}{{ baseImgPath }}{{ image }}">
        <link rel="preload" href="/public/img/bckgr.webp" as="image" fetchpriority="high">
        <link rel="preload" href="/public/css/style.css" as="style">
        <link rel="stylesheet" href="/public/css/style.css" />
        <link rel="canonical" href="{{ metadata.url }}{{ page.url }}" />
        <link rel="preload" href="/public/fonts/imperial.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="icon" href="/public/img/favicon.png" type="image/png" />
        <script src="/public/js/script.js" defer></script>
        <title>{{ seo_title }}</title>
    </head>

    <body>
        <header class="main-header">
            <div class="container">
                <a class="logo" href="/">farfalle</a>
                {% include "partials/search_box.njk" %}
                <input type="checkbox" id="nav-checkbox" class="nav-checkbox" />
                <label
                    for="nav-checkbox"
                    class="nav-toggle"
                    aria-label="Toggle navigation">
                    ☰
                </label>

                <!-- overlay -->
                <label for="nav-checkbox" class="nav-overlay"></label>

                <nav class="nav">
                    <label for="nav-checkbox" class="close-menu">&times;</label>
                    <a href="/">Przepisy</a>
                    <a href="/wypieki">Wypieki</a>
                    <a href="/vege">Vege</a>
                    <a href="/o-mnie">O mnie</a>
                </nav>
            </div>
        </header>

        <main>
            <div class="container full">
                <div class="page-title">
                    <h1>{{ title }}</h1>
                    <p>{{ seo_description }}</p>
                </div>

                 {{ content | safe }}

            </div>
            <button id="scrollTopBtn" aria-label="Przewiń do góry">
            ↑
            </button>
        </main>

        <footer>
            <p>&copy; 2026 Farfalle - Wiesław Mazurak</p>
        </footer>

    </body>
</html>
